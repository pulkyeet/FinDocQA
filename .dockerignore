# Git
.git/
.gitignore

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
*.egg-info/

# Data (too large for deployment — pre-built reports only)
src/data/raw/
src/data/chunks/
src/data/chroma/
src/data/eval/
src/data/diffs/

# Keep pre-built reports for serving
!src/data/reports/

# ...except the A/B variants. These are local analysis artifacts (rerender.py
# --no-item8 --suffix _variantB); app.py mounts the whole reports dir at
# /reports, so anything shipped here is publicly fetchable. Last match wins in
# .dockerignore, so this line overrides the negation above.
src/data/reports/*_variant*.html

# Dev-only requirements (torch etc.) — the image installs requirements-web.txt
requirements.txt

# IDE
.vscode/
.idea/
.playwright-mcp/

# Environment
.env
.env.local

# OS
.DS_Store
Thumbs.db
