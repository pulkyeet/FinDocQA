# Copy to src/.env and fill in values (never commit src/.env)
# SEC requires a descriptive User-Agent; generic agents may be rate-limited.
SEC_USER_AGENT=FinDocQA/1.0 (your@email.com)
# Preferred LLM backend for Delta interpretation (stage 7-8).
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL=deepseek/deepseek-v4-flash
# Optional: speeds up HuggingFace model downloads and avoids rate limits.
HF_TOKEN=hf_...
